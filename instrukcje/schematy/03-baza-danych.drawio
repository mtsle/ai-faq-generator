        <mxCell id="1" parent="0" />
        <mxCell id="tytul" value="Schemat bazy danych (AIFAQ_DB_VERSION = 6)&#10;Piec tabel z prefiksem witryny + opcje w wp_options. Wszystko na hostingu klienta — wtyczka nie wysyla danych nigdzie poza Gemini." style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="24" y="16" width="1440" height="46" as="geometry" /></mxCell>
        <mxCell id="knowledge" value="wp_aifaq_knowledge — baza wiedzy RAG&#10;id · post_id · chunk_index · content&#10;content_hash · embedding (768) · tokens · updated_at&#10;UNIQUE(post_id, chunk_index) · KEY content_hash" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;fontColor=#4C1D95;fontSize=12;arcSize=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="420" height="130" as="geometry" /></mxCell>
        <mxCell id="cache_t" value="wp_aifaq_cache — powtorzone pytania&#10;id · question_hash · question · answer&#10;score · hits · created_at&#10;UNIQUE(question_hash)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;fontColor=#4C1D95;fontSize=12;arcSize=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="520" y="110" width="420" height="130" as="geometry" /></mxCell>
        <mxCell id="qa_log" value="wp_aifaq_qa_log — dziennik pytan gosci&#10;id · created_at · question · answer · status&#10;source · score · user_id · ip_hash (nie surowe IP)&#10;KEY created_at, status, (created_at,id) [K23]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;fontColor=#4C1D95;fontSize=12;arcSize=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1000" y="110" width="460" height="130" as="geometry" /></mxCell>
        <mxCell id="generations" value="wp_aifaq_generations — historia generowan FAQ&#10;id · created_at · topic · extra_desc&#10;num_questions · language · user_id · pairs_json&#10;KEY created_at, (created_at,id) [K23]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;fontColor=#4C1D95;fontSize=12;arcSize=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="420" height="130" as="geometry" /></mxCell>
        <mxCell id="faq_t" value="wp_aifaq_faq — tabela zaszlosciowa&#10;id · post_id · question · answer&#10;position · created_at · updated_at&#10;NIEUZYWANA — publikacja idzie przez opcje" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;fontColor=#0F172A;fontSize=12;arcSize=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="520" y="300" width="420" height="130" as="geometry" /></mxCell>
        <mxCell id="opcje" value="wp_options — konfiguracja i stan&#10;aifaq_settings (35 pol, w tym klucz API)&#10;aifaq_public_faq + _prev + _lock — opublikowane pary&#10;aifaq_page_id / _state / _ok — podstrona generatora&#10;aifaq_menu_item_id / _state — pozycja w menu&#10;aifaq_daily_usage · aifaq_index_signature · aifaq_crawl_state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;fontColor=#4C1D95;fontSize=12;arcSize=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1000" y="300" width="460" height="160" as="geometry" /></mxCell>
        <mxCell id="posty" value="wp_posts / wp_postmeta&#10;zrodlo tresci do indeksowania" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF4FF;strokeColor=#1D4ED8;fontColor=#1E3A8A;fontSize=12;arcSize=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="420" height="62" as="geometry" /></mxCell>
        <mxCell id="kto_knowledge" value="Kto pisze i czyta&#10;Indexer (zapis) · Retriever (odczyt)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#047857;fontColor=#064E3B;fontSize=12;arcSize=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="520" y="500" width="420" height="62" as="geometry" /></mxCell>
        <mxCell id="uninstall" value="uninstall.php&#10;kasuje 5 tabel, 25+ opcji, 2 crony i transienty&#10;— odinstalowanie nie zostawia sladu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;fontColor=#7C2D12;fontSize=12;arcSize=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1000" y="500" width="460" height="80" as="geometry" /></mxCell>
