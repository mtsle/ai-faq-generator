<mxfile host="app.diagrams.net" version="24.0.0" type="device">
  <diagram name="Przebieg cykliczny — trzy fazy pod jedny" id="04-przebieg-cykliczny">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="940" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="tytul" value="Przebieg cykliczny — trzy fazy pod jednym zamkiem&#10;ainp_tick, co godzinę, tylko przy ruchu na witrynie. Budżet 25 s dzielony ¼ / ¼ / reszta. Przyciski panelu wołają te same fazy z własnymi budżetami." style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="24" y="16" width="1500" height="46" as="geometry" /></mxCell>
        <mxCell id="k_fazy" value="Trzy fazy, zawsze w tej kolejności" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#334155;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="500" y="100" width="700" height="470" as="geometry" /></mxCell>
        <mxCell id="zdarzenie" value="WP-Cron: ainp_tick&#10;powtarzalne, hourly" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF4FF;strokeColor=#1D4ED8;fontColor=#1E3A8A;fontSize=12;arcSize=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="80" y="60" width="360" height="60" as="geometry" /></mxCell>
        <mxCell id="zamek" value="Zamek ainp_run_lock&#10;INSERT IGNORE — kto pierwszy, ten jedzie&#10;przejęcie po TTL 120 s (CAS po tokenie)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;fontColor=#7C2D12;fontSize=12;arcSize=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="80" y="148" width="360" height="78" as="geometry" /></mxCell>
        <mxCell id="zajety" value="Zamek zajęty → przebieg kończy się&#10;bez pracy i bez błędu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;fontColor=#0F172A;fontSize=12;arcSize=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="80" y="254" width="360" height="60" as="geometry" /></mxCell>
        <mxCell id="f1" value="FAZA 1 — pobranie&#10;kanały z listy, do 100 pozycji na kanał&#10;dedup po adresie, zapis jako new&#10;działka czasu: ¼ budżetu · ZERO wywołań AI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#047857;fontColor=#064E3B;fontSize=12;arcSize=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="520" y="144" width="660" height="108" as="geometry" /></mxCell>
        <mxCell id="f2" value="FAZA 2 — przygotowanie&#10;partia 10 pozycji: filtr słów, doczytanie treści,&#10;dedup po treści&#10;działka: ¼ budżetu · ZERO wywołań AI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#047857;fontColor=#064E3B;fontSize=12;arcSize=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="520" y="270" width="660" height="108" as="geometry" /></mxCell>
        <mxCell id="f3" value="FAZA 3 — publikacja&#10;do 3 pozycji, każda = 1 wywołanie AI&#10;walidacja kontraktu, wpis, termin&#10;działka: reszta budżetu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#B91C1C;fontColor=#7F1D1D;fontSize=12;arcSize=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="520" y="396" width="660" height="108" as="geometry" /></mxCell>
        <mxCell id="budzet" value="Budżet czasu przycina timeout żądania&#10;poniżej 8 s wywołania NIE zaczynamy —&#10;ucięte żądanie i tak spaliłoby slot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEFCE8;strokeColor=#CA8A04;fontColor=#713F12;fontSize=12;arcSize=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1240" y="208" width="300" height="110" as="geometry" /></mxCell>
        <mxCell id="recover" value="Odzyskiwanie zawieszonych&#10;processing starszy niż 900 s wraca do new" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF4FF;strokeColor=#1D4ED8;fontColor=#1E3A8A;fontSize=12;arcSize=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1240" y="360" width="300" height="80" as="geometry" /></mxCell>
        <mxCell id="koniec" value="Zwolnienie zamka — WARUNKOWE&#10;kasujemy tylko własny wpis (token)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;fontColor=#7C2D12;fontSize=12;arcSize=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="520" y="620" width="660" height="60" as="geometry" /></mxCell>
        <mxCell id="log" value="Ślad przebiegu w transiencie&#10;ainp_last_tick, ważny 24 h — to on zasila ramkę&#10;„Ostatni automatyczny przebieg” w panelu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;fontColor=#4C1D95;fontSize=12;arcSize=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="520" y="708" width="660" height="78" as="geometry" /></mxCell>
        <mxCell id="przyciski" value="Panel: te same fazy, inne budżety&#10;„Pobierz teraz” · „Przygotuj treści” (15 s)&#10;„Opublikuj teraz” (30 s) · „Wznów nieudane”" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;fontColor=#0F172A;fontSize=12;arcSize=8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="80" y="620" width="360" height="100" as="geometry" /></mxCell>
