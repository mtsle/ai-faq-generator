        <mxCell id="e1" value="nie udało się" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;fontSize=11;fontColor=#334155;endArrow=block;endFill=1;" edge="1" parent="1" source="zamek" target="zajety"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="zamek zdobyty" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;fontSize=11;fontColor=#334155;endArrow=block;endFill=1;" edge="1" parent="1" source="zamek" target="f1"><mxGeometry relative="1" as="geometry" /></mxCell>
