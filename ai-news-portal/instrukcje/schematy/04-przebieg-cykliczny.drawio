        <mxCell id="e6" value="ile czasu zostało?" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=2;fontSize=11;fontColor=#334155;endArrow=block;endFill=1;" edge="1" parent="1" source="f3" target="budzet"><mxGeometry relative="1" as="geometry" /></mxCell>
